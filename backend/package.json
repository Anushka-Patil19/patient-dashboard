{
  "name": "patient-dashboard-api",
  "version": "1.0.0",
  "private": true,
  "description": "Rural Outreach Patient Dashboard - REST API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/db/migrate.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "db:local": "node scripts/local-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
