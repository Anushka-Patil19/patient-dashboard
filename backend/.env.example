# Copy to .env for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://outreach:outreach@localhost:55432/outreach
# Set to true for managed Postgres that requires TLS (Render, Neon, RDS).
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
PSEUDONYM_SECRET=dev-only-pseudonym-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Path to the built frontend (frontend/dist) to serve it from the API.
STATIC_DIR=
SEED_DEMO_DATA=false
